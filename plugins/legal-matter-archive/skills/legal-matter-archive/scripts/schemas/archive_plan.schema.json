{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "archive_plan.schema.json",
  "type": "object", "required": ["schema_version", "profile", "matter_id", "run_dir", "template_mode", "items", "blockers", "risks", "status", "confirmation_token"],
  "properties": {
    "schema_version": {"const": "1.0"}, "profile": {"enum": ["litigation", "special_nonlitigation", "regular_counsel_close"]},
    "matter_id": {"type": "string"}, "run_dir": {"type": "string"}, "template_mode": {"enum": ["pdf", "docx"]},
    "items": {"type": "array"}, "blockers": {"type": "array"}, "risks": {"type": "array"},
    "status": {"enum": ["blocked", "preview"]}, "confirmation_token": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
